<?xml version="1.0" encoding="utf-8"?>
<!-- Medium size: no section headers, four bars with a coloured provider prefix
     (C = Claude, X = Codex) and every reset countdown still on its own row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="C·S"
            android:textColor="#D97757"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/c_session_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_green"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/c_session_pct"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#6ee7b7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/c_session_reset"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="9sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="C·W"
            android:textColor="#D97757"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/c_weekly_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_green"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/c_weekly_pct"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#6ee7b7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/c_weekly_reset"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="9sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="X·S"
            android:textColor="#7DD3FC"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/x_session_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_green"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/x_session_pct"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#6ee7b7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/x_session_reset"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="9sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="X·W"
            android:textColor="#7DD3FC"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/x_weekly_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="7dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_green"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="5dp" />

        <TextView
            android:id="@+id/x_weekly_pct"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#6ee7b7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/x_weekly_reset"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="9sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
