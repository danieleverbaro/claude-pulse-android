<?xml version="1.0" encoding="utf-8"?>
<!-- Full size: one column, a labelled section per provider, every bar and every
     reset visible at once. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- ============ CLAUDE ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/claude_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLAUDE"
            android:textColor="#D97757"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/claude_plan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#99FFFFFF"
            android:textSize="10sp"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/updated_ago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#80FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:text="Session"
            android:textColor="#99FFFFFF"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/c_session_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_green"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/c_session_pct"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#6ee7b7"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/c_session_reset"
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="10sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:text="Weekly"
            android:textColor="#99FFFFFF"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/c_weekly_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_green"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/c_weekly_pct"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#6ee7b7"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/c_weekly_reset"
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="10sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- ============ CODEX ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/codex_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CODEX"
            android:textColor="#7DD3FC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/codex_plan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#99FFFFFF"
            android:textSize="10sp"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/refresh_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Refresh"
            android:textColor="#6ee7b7"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:text="Session"
            android:textColor="#99FFFFFF"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/x_session_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_green"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/x_session_pct"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#6ee7b7"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/x_session_reset"
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="10sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:text="Weekly"
            android:textColor="#99FFFFFF"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/x_weekly_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_green"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/x_weekly_pct"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#6ee7b7"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/x_weekly_reset"
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="10sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
