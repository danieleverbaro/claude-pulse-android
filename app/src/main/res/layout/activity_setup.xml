<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="32dp"
    android:paddingRight="32dp"
    android:paddingTop="64dp"
    android:paddingBottom="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Claude Pulse"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paste a Claude or a Codex token — one at a time. The provider is detected from the token itself."
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone" />

    <!-- Shown when at least one provider needs a fresh token -->
    <LinearLayout
        android:id="@+id/error_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#2A1A1A"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠ Token expired"
            android:textColor="#F44336"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Claude — log into Claude Code, then read the refresh token:"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/claude_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="python3 -c &quot;import json;print(json.load(open(&apos;$HOME/.claude/.credentials.json&apos;))[&apos;claudeAiOauth&apos;][&apos;refreshToken&apos;])&quot;"
            android:textColor="#D97757"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:background="#1A1A1A"
            android:padding="12dp"
            android:textIsSelectable="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Codex — same idea, from the Codex CLI credentials:"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/codex_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="python3 -c &quot;import json;print(json.load(open(&apos;$HOME/.codex/auth.json&apos;))[&apos;tokens&apos;][&apos;refresh_token&apos;])&quot;"
            android:textColor="#7DD3FC"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:background="#1A1A1A"
            android:padding="12dp"
            android:textIsSelectable="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paste the new token below."
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/token_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:gravity="top|start"
        android:hint="Token..."
        android:textColorHint="#555555"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:background="#2A2A2A"
        android:padding="16dp"
        android:inputType="textMultiLine"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/connect_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Connect"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#6ee7b7" />

</LinearLayout>
</ScrollView>
